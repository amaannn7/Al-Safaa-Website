# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://flyalsafaa.com

# Set to "true" ONLY for the production launch. Anything else = noindex + robots.txt disallow.
NEXT_PUBLIC_ALLOW_INDEXING=

# Optional: show live Google reviews (Places API (New)). Restrict the key to that API.
GOOGLE_PLACES_API_KEY=

# Optional, non-production only: preview the site as of a date, e.g. 2027-05-03
PREVIEW_TODAY=
